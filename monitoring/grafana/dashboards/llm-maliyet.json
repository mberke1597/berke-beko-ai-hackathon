{
  "uid": "llm-maliyet",
  "title": "LLM ve Maliyet",
  "tags": [
    "beko",
    "llm"
  ],
  "description": "Token kullanımı, maliyet (gen_ai_cost_usd_total), ajan süresi, araç çağrıları ve guardrail kararları. Metrikler Faz 2 ile gelir; o zamana kadar paneller boş görünür.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "agent",
        "label": "Ajan",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gen_ai_cost_usd_total, agent)",
          "refId": "agent"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gen_ai_cost_usd_total, model)",
          "refId": "model"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "trace_id",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Tüm izleri keşfet",
      "type": "link",
      "url": "/grafana/explore?schemaVersion=1&panes=%7B%22a%22:%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22datasource%22:%7B%22type%22:%22tempo%22,%22uid%22:%22tempo%22%7D,%22queryType%22:%22traceql%22,%22query%22:%22%7Bresource.service.name%3D%5C%22beko-backend%5C%22%7D%22%7D%5D%7D%7D&orgId=1",
      "icon": "external link",
      "targetBlank": false
    }
  ],
