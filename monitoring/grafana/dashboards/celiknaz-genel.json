      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"beko-backend\",http_route!~\"/health.*\"}[5m]))",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
