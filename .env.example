# Copy to .env (never commit .env). Placeholders only.
# Generate secrets with: openssl rand -base64 48   (or: openssl rand -hex 24 for DB passwords)
ASPNETCORE_ENVIRONMENT=Development
ANTHROPIC_API_KEY=changeme
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
JWT_SIGNING_KEY=changeme-at-least-32-bytes-long-random-value
POSTGRES_PASSWORD=changeme
MONGO_PASSWORD=changeme
GRAFANA_ADMIN_PASSWORD=changeme
APP_VERSION=0.1.0
APP_COMMIT=local
# Çeliknaz simulator (demo: SIMULATION_TIME_SCALE=60)
SIMULATION_TIME_SCALE=1
SIMULATION_TICK_SECONDS=5
SIMULATION_OUTDOOR_TEMP_C=31
# Host ports of the database containers. Change them if a local Postgres/MongoDB already uses 5432/27017
# (scripts/demo.* picks free ports automatically when these are not set).
#POSTGRES_HOST_PORT=5432
#MONGO_HOST_PORT=27017
